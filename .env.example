# APP_URL: The public URL where Toolivo is hosted (used for canonical URLs, sitemaps, and Dodo Payments redirects).
APP_URL="http://localhost:3000"

# ==============================================================================
# Dodo Payments (Merchant of Record) — Server-Side Secrets Only
# ==============================================================================
# DODO_PAYMENTS_ENVIRONMENT: 'test_mode' for sandbox testing or 'live_mode' for production.
DODO_PAYMENTS_ENVIRONMENT="test_mode"

# DODO_PAYMENTS_API_KEY: Server-side Bearer API key from Dodo Payments Dashboard -> Developer -> API Keys.
DODO_PAYMENTS_API_KEY=""

# DODO_PAYMENTS_WEBHOOK_KEY: Standard Webhooks signing secret (whsec_...) from Dodo Payments Dashboard -> Developer -> Webhooks.
DODO_PAYMENTS_WEBHOOK_KEY=""

# Optional default Dodo Product IDs (can also be configured live in the /admin dashboard per currency)
# Separate INR & USD product IDs allow explicit regional pricing without FX conversion.
DODO_PRODUCT_PASS_7D_USD=""
DODO_PRODUCT_PASS_7D_INR=""
DODO_PRODUCT_PRO_MONTHLY_USD=""
DODO_PRODUCT_PRO_MONTHLY_INR=""
DODO_PRODUCT_PRO_YEARLY_USD=""
DODO_PRODUCT_PRO_YEARLY_INR=""
DODO_PRODUCT_PRO_LIFETIME_USD=""
DODO_PRODUCT_PRO_LIFETIME_INR=""
DODO_PRODUCT_CREDITS_100_USD=""
DODO_PRODUCT_CREDITS_100_INR=""
DODO_PRODUCT_CREDITS_500_USD=""
DODO_PRODUCT_CREDITS_500_INR=""
DODO_PRODUCT_SPONSOR_BANNER_USD=""
DODO_PRODUCT_SPONSOR_BANNER_INR=""
DODO_PRODUCT_SPONSOR_TIER1_USD=""
DODO_PRODUCT_SPONSOR_TIER1_INR=""
DODO_PRODUCT_SPONSOR_TIER2_USD=""
DODO_PRODUCT_SPONSOR_TIER2_INR=""
DODO_PRODUCT_SPONSOR_TIER3_USD=""
DODO_PRODUCT_SPONSOR_TIER3_INR=""

# ==============================================================================
# Admin Dashboard & Session Security
# ==============================================================================
# ADMIN_PASSCODE: Server-side passcode for /admin pricing & sponsor approval dashboard.
# If left empty on first run, /admin displays a one-time setup form to claim an admin password.
ADMIN_PASSCODE=""

# ==============================================================================
# Database & Email Notifications (Server-Side)
# ==============================================================================
# BILLING_DB_PATH: Optional filesystem path for the SQLite billing ledger (defaults to ./data/toolivo-billing.sqlite).
BILLING_DB_PATH=""

# RESEND_API_KEY: Optional transactional email API key for delivering recovery keys & sponsor notifications.
RESEND_API_KEY=""

# EMAIL_FROM: Verified sender address for transactional notifications (e.g. "Toolivo Billing <billing@toolivo.app>").
EMAIL_FROM="Toolivo Billing <billing@toolivo.app>"

# GEMINI_API_KEY: Optional server-side key reserved for future optional AI utilities.
GEMINI_API_KEY=""
